<?xml version="1.0"?>
<ruleset name="Citeoryx">
	<description>Citeoryx WordPress coding standards.</description>

	<file>citeoryx.php</file>
	<file>uninstall.php</file>
	<file>bin/resolve-wp-test-versions.php</file>
	<file>src</file>
	<file>tests</file>

	<arg name="extensions" value="php" />
	<arg name="parallel" value="8" />
	<arg value="ps" />

	<exclude-pattern>vendor/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.6" />

	<rule ref="WordPress-Extra">
		<!-- Citeoryx uses Composer PSR-4 class names instead of class-*.php files. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<!-- These PSR-style idioms are used deliberately throughout the domain layer. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames" />
		<exclude name="Universal.Operators.DisallowShortTernary" />
	</rule>

	<!-- The standalone test installer runs before WordPress APIs are available. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>bin/resolve-wp-test-versions.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>bin/resolve-wp-test-versions.php</exclude-pattern>
	</rule>
</ruleset>
