{
  "name": "citeoryx-admin",
  "version": "2.3.0",
  "description": "Citeoryx WordPress Plugin Admin UI",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=assets/src/admin",
    "start": "wp-scripts start --webpack-src-dir=assets/src/admin",
    "env:start": "npx --yes @wordpress/env@11.11.0 start",
    "env:stop": "npx --yes @wordpress/env@11.11.0 stop",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "test": "wp-scripts test-unit-js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@wordpress/components": "^28.0.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/scripts": "^27.0.0",
    "@wordpress/notices": "^5.0.0",
    "@wordpress/icons": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.4.5"
  },
  "dependencies": {}
}
