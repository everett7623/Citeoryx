{
  "name": "citeoryx/citeoryx",
  "description": "WordPress Content Health & AI Discoverability Engine",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "everettlabs",
      "email": "everett7623@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.0",
    "yoast/phpunit-polyfills": "^2.0.5",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Citeoryx\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Citeoryx\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-install": "bash bin/install-wp-tests.sh wordpress_test root root 127.0.0.1 latest",
    "phpcompat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.0- src/",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "config": {
    "platform": {
      "php": "8.0.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
